# Copy this file to `.env` and adjust values for your local / production setup.
#
# For LOCAL development on your Windows machine, typically:
#   - PostgreSQL runs either on your host or in another container.
#   - From containers, you can often reach the host as `host.docker.internal`.
# For PRODUCTION on EC2:
#   - PostgreSQL runs directly on the EC2 host (not in Docker).
#   - From containers, use the EC2 PRIVATE or PUBLIC IP, not 127.0.0.1.

########################################
# Flask API / Database
########################################

# PostgreSQL connection string (used by Flask via Config.SQLALCHEMY_DATABASE_URI)
# Example for LOCAL (Docker Desktop on Windows, Postgres on host):
#   postgresql+psycopg2://USER:PASSWORD@host.docker.internal:5432/to_their_rescue
# Example for EC2 (Postgres on EC2 host, containers on same machine):
#   postgresql+psycopg2://USER:PASSWORD@<EC2-PRIVATE-OR-PUBLIC-IP>:5432/to_their_rescue
DATABASE_URL=postgresql+psycopg2://postgres:123456@db:5432/ttr
POSTGRES_DB=ttr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432

FLASK_SECRET_KEY=e460699e9eabb64485e47d831974c9c757aee129f0a023055fe00e7a4c913685
JWT_SECRET_KEY=de756725637f7fd74ec0e786053436df
JWT_ACCESS_EXPIRES_MIN=30
JWT_REFRESH_EXPIRES_DAYS=7

# email service
SENDGRID_API_KEY=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
EMAIL_FROM=services@totheirrescue.org
EMAIL_FROM_NAME="TO THEIR RESCUE TEAM"

# If set to 1, API entrypoint will run:
#   flask db migrate -m "auto migration"  (best-effort)
#   flask db upgrade
AUTO_MIGRATE=1

# Flask environment: "development" or "production"
FLASK_ENV=production

########################################
# Next.js frontend
########################################

# Base URL that the BROWSER will use to call the API.
# For LOCAL dev (docker-compose.dev.yml):
#   Frontend runs at http://localhost:3003
#   API runs at http://localhost:5000
#   and we set NEXT_PUBLIC_API_URL=http://localhost:5000 in docker-compose.dev.yml.
#
# For PRODUCTION on EC2 behind Nginx:
#   Nginx routes:
#     /       -> Next.js
#     /api/   -> Flask API
#   So the browser should call the API via:
#     http://<EC2-IP-OR-HOSTNAME>/api
#
# Example using your public IP:
#   NEXT_PUBLIC_API_URL=http://54.226.98.185/api
NEXT_PUBLIC_API_URL=https://toyourrescue.org

########################################
# pgAdmin (DB admin UI)
########################################

# pgAdmin address / login
PGADMIN_DEFAULT_EMAIL=admin@ttr.com
PGADMIN_DEFAULT_PASSWORD=123456

# Host port for pgAdmin web UI:
#   LOCAL:  5050 -> http://localhost:5050
#   EC2:    5050 -> http://54.226.98.185:5050  (ensure security group rules!)
PGADMIN_PORT=5050
PGADMIN_BIND_IP=0.0.0.0
PGADMIN_PORT=5050

NEXT_PUBLIC_SUPER_ADMIN_USERNAME_HINT=superadmin
NEXT_PUBLIC_SUPER_ADMIN_PASSWORD_HINT=superadmin